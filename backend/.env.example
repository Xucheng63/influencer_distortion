# Distortion sidecar — environment template. Copy to .env and fill in.
# NEVER commit real secret values; .env is gitignored.

# Level-3 LLM verification (optional — without any key, classification is
# rules-only). First configured provider wins, in this order:
#   ANTHROPIC_API_KEY  → native Claude
#   OPENROUTER_API_KEY → Claude via OpenRouter (OpenAI-compatible)
#   OPENAI_API_KEY     → OpenAI gpt-4o-mini
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# Override the Level-3 model slug (defaults are provider-specific).
DISTORTION_LLM_MODEL=

# Twitter/X session cookies (from a logged-in x.com browser session:
# DevTools → Application → Cookies → x.com → auth_token / ct0).
TWITTER_AUTH_TOKEN=
TWITTER_CT0=

# Weibo session cookies (from a logged-in weibo.com session: SUB / SUBP).
WEIBO_SUB=
WEIBO_SUBP=

# Reddit login (optional). Public subreddit/user pages need no auth; these are
# only used as a fallback when Reddit forces a login wall during scraping.
# An IP block cannot be bypassed by logging in.
REDDIT_USERNAME=
REDDIT_PASSWORD=

# Chromium tuning. Set to 0 on hosts with >=2GB RAM to render Twitter/X fully.
CHROMIUM_LOW_MEMORY=1

# Optional: residential proxy for Twitter (http://user:pass@host:port).
TWITTER_PROXY=

# CORS origins allowed to call the sidecar (comma-separated).
CORS_ORIGINS=http://localhost:8080
